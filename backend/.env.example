    # --- Database ---
    # Postgres connection string. Use Supabase's "Connection string" with psycopg2 driver.
    DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/reels

    # --- Google Gemini ---
    # Get from https://aistudio.google.com/apikey
    GEMINI_API_KEY=

    # --- Pexels ---
    # Get from https://www.pexels.com/api/
    PEXELS_API_KEY=

    # --- Supabase ---
    # Project Settings → API
    SUPABASE_URL=
    SUPABASE_SERVICE_ROLE_KEY=
    # Storage bucket name (create it in Supabase Storage, set it to public)
    SUPABASE_BUCKET=reels

    # --- Make.com ---
    # The Custom Webhook URL Make.com gives you in step 1 of make-com-flow.md
    MAKE_COM_WEBHOOK_URL=
    # Run: openssl rand -hex 32  — paste the same value in the Make.com scenario variable MAKE_COM_CALLBACK_SECRET
    MAKE_COM_CALLBACK_SECRET=change-me-to-a-32-char-random-string
    # Used by Make.com to call back into FastAPI
    APP_BASE_URL=http://localhost:8000

    # --- CORS ---
    # Comma-separated list of allowed origins for the frontend
    CORS_ORIGINS=http://localhost:3000

    # --- Worker ---
    # Local directory for edge-tts output, downloaded clips, and final MP4s
    LOCAL_STORAGE_DIR=./storage

# --- Mock mode ---
# When true, POST /api/campaigns skips Make.com and simulates the callback
# inline with stubbed data. The full backend pipeline (edge-tts + MoviePy +
# Supabase upload) still runs end-to-end. Set to false to use real Make.com.
MOCK_MODE=true
