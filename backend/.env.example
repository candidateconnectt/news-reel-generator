# --- Database ---
# Supabase Transaction Pooler connection string.
# Format: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Google Gemini ---
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Pexels ---
# Get from https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Supabase ---
# Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Database password (from Supabase dashboard → Settings → Database)
SUPABASE_DATABASE_PASSWORD=
# Storage bucket name (create it in Supabase Storage, set it to public)
SUPABASE_BUCKET=reels

# --- Make.com ---
# The Custom Webhook URL Make.com gives you in step 1 of make-com-flow.md
MAKE_COM_WEBHOOK_URL=
# Run: openssl rand -hex 32  — paste the same value in the Make.com scenario variable MAKE_COM_CALLBACK_SECRET
MAKE_COM_CALLBACK_SECRET=
# Used by Make.com to call back into FastAPI
APP_BASE_URL=https://your-railway-app.railway.app

# --- CORS ---
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=https://your-vercel-frontend.vercel.app

# --- Worker ---
# Local directory for temp files (cleared after each render)
LOCAL_STORAGE_DIR=/tmp

# --- Mock mode ---
# Set to false in production (real Make.com mode)
MOCK_MODE=true
