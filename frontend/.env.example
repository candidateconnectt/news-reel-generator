# FastAPI base URL — your Railway backend URL
# (the hardcoded fallback in lib/api.ts already points at the production URL,
#  so you can leave this empty in Vercel and it will still work)
NEXT_PUBLIC_API_BASE_URL=https://news-reel-generator-production.up.railway.app

# Supabase (only needed for the video player URL; safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_BUCKET=reels
